{
	email ckstn1112@gmail.com
	servers :443 {
		protocols h1
	}
}

coldwaterkim.com, www.coldwaterkim.com {
	encode zstd gzip

	# PocketBase is loopback-only and trusts this client IP header only from Caddy.
	# Every upstream block below overwrites any value supplied by the public client.
	request_body {
		max_size 20GiB
	}

	handle /api/cwk/tus/status {
		reverse_proxy 127.0.0.1:8090 {
			header_up X-CWK-Client-IP {http.request.remote.host}
			header_down X-CWK-Client-IP {client_ip}
		}
	}

	handle /api/cwk/tools/* {
		request_body {
			max_size 202MiB
		}
		reverse_proxy 127.0.0.1:8090 {
			header_up X-CWK-Client-IP {http.request.remote.host}
		}
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8090 {
			header_up X-CWK-Client-IP {http.request.remote.host}
		}
	}

	handle /_/* {
		reverse_proxy 127.0.0.1:8090 {
			header_up X-CWK-Client-IP {http.request.remote.host}
		}
	}

	handle /sitemap.xml {
		reverse_proxy 127.0.0.1:8090 {
			header_up X-CWK-Client-IP {http.request.remote.host}
		}
	}

	handle /posts/*/ {
		reverse_proxy 127.0.0.1:8090 {
			header_up X-CWK-Client-IP {http.request.remote.host}
		}
	}

	handle /daily/*/ {
		reverse_proxy 127.0.0.1:8090 {
			header_up X-CWK-Client-IP {http.request.remote.host}
		}
	}

	handle {
		root * "/Users/kimchansu/.local/share/coldwaterkim/home-server/dist"
		try_files {path} {path}/ =404
		file_server
	}

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	handle_errors {
		@maintenance expression `{err.status_code} >= 502 && {err.status_code} <= 504`
		handle @maintenance {
			root * "/Users/kimchansu/.local/share/coldwaterkim/home-server/dist"
			rewrite * /maintenance.html
			header Cache-Control "no-store"
			header Retry-After "5"
			file_server
		}
	}
}
