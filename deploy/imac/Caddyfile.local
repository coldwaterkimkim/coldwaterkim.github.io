http://127.0.0.1:18081 {
	encode zstd gzip

	# Match production's loopback-only PocketBase client IP trust boundary.
	# Every upstream block below overwrites any caller-supplied header value.
	request_body {
		max_size 20GiB
	}

	handle /api/cwk/tools/* {
		request_body {
			max_size 202MiB
		}
		reverse_proxy 127.0.0.1:8090 {
			header_up X-CWK-Client-IP {http.request.remote.host}
		}
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8090 {
			header_up X-CWK-Client-IP {http.request.remote.host}
		}
	}

	handle /_/* {
		reverse_proxy 127.0.0.1:8090 {
			header_up X-CWK-Client-IP {http.request.remote.host}
		}
	}

	handle /sitemap.xml {
		reverse_proxy 127.0.0.1:8090 {
			header_up X-CWK-Client-IP {http.request.remote.host}
		}
	}

	handle /posts/*/ {
		reverse_proxy 127.0.0.1:8090 {
			header_up X-CWK-Client-IP {http.request.remote.host}
		}
	}

	handle /daily/*/ {
		reverse_proxy 127.0.0.1:8090 {
			header_up X-CWK-Client-IP {http.request.remote.host}
		}
	}

	handle {
		root * "/Users/kimchansu/Code/coldwaterkim.github.io/dist"
		try_files {path} {path}/ =404
		file_server
	}

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	handle_errors {
		@maintenance expression `{err.status_code} >= 502 && {err.status_code} <= 504`
		handle @maintenance {
			root * "/Users/kimchansu/Code/coldwaterkim.github.io/dist"
			rewrite * /maintenance.html
			header Cache-Control "no-store"
			header Retry-After "5"
			file_server
		}
	}
}
